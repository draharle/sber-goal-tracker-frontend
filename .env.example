# Скопируйте в .env, если нужно поменять адреса. Без .env всё работает со значениями по умолчанию.

# Куда проксируется /api: dev-сервер Vite (npm run dev) и nginx в Docker.
# Локально по умолчанию http://localhost:8000; в docker-compose — http://mock-api:8000.
API_PROXY_TARGET=http://localhost:8000

# Базовый адрес API для браузера. Пусто = тот же адрес, что у страницы (запросы идут через прокси выше).
# Задайте, только если хотите ходить в API напрямую, например http://localhost:8000 (у mock API открыт CORS).
# Подставляется при сборке (vite build / docker compose build).
VITE_API_URL=

# Порт, на котором docker compose публикует фронтенд.
FRONTEND_PORT=8080
