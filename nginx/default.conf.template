# Шаблон конфигурации nginx. При старте контейнера официальный образ nginx подставляет
# переменные окружения (envsubst) и кладёт результат в /etc/nginx/conf.d/default.conf.
# API_PROXY_TARGET — адрес API без слеша в конце, например http://mock-api:8000.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Запросы страницы к /api/* уходят в API. Браузер ходит на тот же адрес — CORS не нужен.
    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Файлы сборки с хэшем в имени — кэшируем надолго.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Страница одна, состояние в query-строке; index.html не кэшируем, чтобы новая сборка подхватывалась сразу.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
